# ==========================================================
# 1. RENDER BACKEND ENVIRONMENT VARIABLES
# ==========================================================
PORT=5000
NODE_ENV=production
JWT_SECRET=nile_campus_lost_and_found_jwt_secret_2026

# Keep-Alive Plunger Target URL (Your Render public URL)
RENDER_EXTERNAL_URL=https://student-lost-and-found.onrender.com
PLUNGER_INTERVAL_MS=600000

# Optional Cloud Database (Works out-of-the-box without these via Persistent File Store)
# Option A: PostgreSQL (Neon.tech / Supabase / Render Postgres)
DATABASE_URL=
# Option B: MongoDB Atlas
MONGODB_URI=

# Optional Cloud Image Storage (Works out-of-the-box without these via local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES
# ==========================================================
VITE_API_BASE_URL=https://student-lost-and-found.onrender.com
VITE_WS_URL=wss://student-lost-and-found.onrender.com/ws
