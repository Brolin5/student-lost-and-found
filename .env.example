# Server Configuration
PORT=5000
JWT_SECRET=super_secret_campus_jwt_key_2026

# PostgreSQL Database Configuration (Paste your Postgres connection URI here)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Alternative MongoDB URI (if using MongoDB Atlas)
MONGODB_URI=

# Cloudinary Image Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Or single URL format:
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
